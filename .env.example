# Android TV Home Switcher - configuration template
# Copy this file to .env and fill in your TV's address.

# ---- TV connection ---------------------------------------------------------
# Find it on the TV: Settings -> Network & Internet -> Network status
# Note: You can also pass the IP directly on the command line, e.g.:
#   ./switch.sh fresh 192.168.1.50
TV_HOST=192.168.1.50
TV_PORT=5555

# Optional: absolute path to adb. Leave unset to auto-detect PATH or the Android SDK.
# ADB_PATH=/Users/you/Library/Android/sdk/platform-tools/adb

# Optional: use an already-connected serial instead of TV_HOST:TV_PORT
# TV_SERIAL=192.168.1.50:5555

# Seconds to wait for the ADB connection
CONNECT_TIMEOUT=20

# ---- Launcher identities ---------------------------------------------------
# Stock launcher:
# By default, switch.sh and backup.sh automatically detect whether your TV is
# Google TV (com.google.android.apps.tv.launcherx), Android TV Leanback
# (com.google.android.tvlauncher), Xiaomi PatchWall (com.mitv.tvhome), or another OEM.
# You only need to uncomment and set these if you want to override auto-detection:
# STOCK_PACKAGE=com.google.android.tvlauncher
# STOCK_ACTIVITY=com.google.android.tvlauncher/.MainActivity

# Aqua TV Home (both builds share this package)
LAUNCHER_PACKAGE=com.gathin.tvhome
LAUNCHER_ACTIVITY=com.gathin.tvhome/.MainActivity

# ---- APK paths (relative to this repository folder) -------------------------
FRESH_APK=apks/aqua-tv-home-fresh.apk
WIDGETS_APK=apks/aqua-tv-home-widgets.apk
