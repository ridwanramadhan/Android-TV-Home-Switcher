<?xml version="1.0" encoding="utf-8"?>
<!-- The fullscreen adzan overlay, shared by Home (activity_main) and AdzanActivity so the two cannot drift:
     their copies had already diverged in text sizes and accessibility flags. Include it, do not copy it.
     AdzanPlayer shows it with View.VISIBLE, so it starts hidden. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/adzanOverlay"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000"
    android:visibility="gone"
    android:clickable="true"
    android:focusable="true"
    android:focusableInTouchMode="true">

    <com.gathin.tvhome.FullScreenTextureView
        android:id="@+id/adzanTextureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <!-- Subtle gradients for high contrast readability of glass HUD controls -->
    <View
        android:id="@+id/adzanGradientTop"
        android:layout_width="match_parent"
        android:layout_height="160dp"
        android:layout_gravity="top"
        android:background="@drawable/adzan_gradient_top" />

    <View
        android:id="@+id/adzanGradientBottom"
        android:layout_width="match_parent"
        android:layout_height="180dp"
        android:layout_gravity="bottom"
        android:background="@drawable/adzan_gradient_bottom" />

    <!-- Top Prayer Header -->
    <LinearLayout
        android:id="@+id/adzanHeader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="52dp"
        android:layout_marginTop="38dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/adzanTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/adzan_title_default"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.03"
            android:shadowColor="#80000000"
            android:shadowDx="0"
            android:shadowDy="2"
            android:shadowRadius="6" />

        <TextView
            android:id="@+id/adzanSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/adzan_subtitle"
            android:textColor="#CCFFFFFF"
            android:textSize="15sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.02" />
    </LinearLayout>

    <!-- Bottom Actions (Dismiss / Keep Screen) -->
    <LinearLayout
        android:id="@+id/adzanControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="42dp"
        android:orientation="horizontal"
        android:gravity="center">

        <TextView
            android:id="@+id/btnDismissAdzan"
            style="@style/TopButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:paddingStart="24dp"
            android:paddingEnd="26dp"
            android:text="@string/adzan_dismiss"
            android:textSize="15sp"
            android:drawableStart="@drawable/ic_close_adzan"
            android:drawablePadding="10dp"
            android:focusable="true"
            android:clickable="true" />

        <TextView
            android:id="@+id/btnKeepAdzan"
            style="@style/TopButton"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:layout_marginStart="16dp"
            android:paddingStart="24dp"
            android:paddingEnd="26dp"
            android:text="@string/adzan_keep_screen"
            android:textSize="15sp"
            android:drawableStart="@drawable/ic_fullscreen_adzan"
            android:drawablePadding="10dp"
            android:focusable="true"
            android:clickable="true" />
    </LinearLayout>

    <!-- Remote hint -->
    <TextView
        android:id="@+id/adzanRemoteHint"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="52dp"
        android:layout_marginBottom="22dp"
        android:text="@string/adzan_hint_remote"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:fontFamily="@string/font_medium"
        android:focusable="false"
        android:clickable="false"
        android:importantForAccessibility="no" />

</FrameLayout>
